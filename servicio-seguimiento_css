:root{--bg:#07111f;--panel:#0e1a2a;--line:#23364d;--text:#f8fafc;--muted:#9fb0c4;--green:#22c55e;--blue:#3b82f6;--cyan:#38bdf8;--yellow:#fbbf24;--red:#ef4444;--radius:18px;--shadow:0 18px 50px rgba(0,0,0,.30)}
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{min-height:100vh;font-family:Arial,Helvetica,sans-serif;background:radial-gradient(circle at 20% 0%,rgba(37,99,235,.13),transparent 30%),var(--bg);color:var(--text)}button,a,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.55}[hidden]{display:none!important}
.serviceTrackingPage{width:min(1500px,100%);margin:auto;padding:20px}.serviceHeader{min-height:72px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;padding:0 6px 18px;border-bottom:1px solid var(--line);margin-bottom:18px}.brand{display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none}.brand img{width:58px;height:42px;object-fit:cover;border-radius:8px}.brand b{display:block;font-size:1.25rem}.brand span,.headerCenter p{color:var(--muted);font-size:.84rem}.headerCenter{text-align:center}.headerCenter h1{font-size:1.22rem}.headerActions{display:flex;justify-content:flex-end;gap:9px}.headerActions button,.headerActions a{background:#111d2c;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:10px 14px;text-decoration:none}
.statePanel{min-height:340px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:10px}.statePanel p{color:var(--muted)}.stateIcon{font-size:3rem}.spinner{width:44px;height:44px;border-radius:50%;border:4px solid #24354a;border-top-color:var(--cyan);animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.heroCard,.card{background:linear-gradient(145deg,rgba(18,32,50,.98),rgba(12,25,41,.98));border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.heroCard{padding:24px;margin-bottom:18px}.heroTop{display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:24px;align-items:start}.label{color:var(--muted);font-size:.72rem;font-weight:800;letter-spacing:.09em;display:block;margin-bottom:7px}.heroTop strong{display:block;font-size:1.35rem}.heroTop small{display:block;color:var(--muted);margin-top:7px}.statusBox{text-align:center}.statusBadge{display:inline-block!important;padding:9px 18px;border-radius:999px;background:#1d4ed8;color:#fff;font-size:.93rem!important}.statusBadge[data-state="finalizado"]{background:#15803d}.statusBadge[data-state="cancelado"]{background:#b91c1c}.statusBadge[data-state="arribo"]{background:#0f766e}.statusBadge[data-state="en_camino"]{background:#2563eb}
.progressTrack{display:flex;align-items:flex-start;margin-top:30px;overflow-x:auto;padding-bottom:6px}.progressStep{min-width:105px;text-align:center;opacity:.42;transition:.25s}.progressStep span{width:42px;height:42px;border-radius:50%;margin:0 auto 8px;display:flex;align-items:center;justify-content:center;border:2px solid #52647a;background:#111e2f}.progressStep b{font-size:.78rem;display:block}.progressStep small{font-size:.68rem;color:var(--muted);display:block;margin-top:4px}.progressStep.done,.progressStep.active{opacity:1}.progressStep.done span{background:#128247;border-color:#22c55e}.progressStep.active span{background:#e7f1ff;color:#1463d6;border-color:#60a5fa;box-shadow:0 0 0 5px rgba(59,130,246,.15)}.progressLine{min-width:45px;height:2px;background:#33465d;margin-top:20px}.progressLine.done{background:#22c55e}
.mainGrid{display:grid;grid-template-columns:minmax(0,2fr) minmax(300px,.95fr);gap:18px}.leftColumn,.rightColumn{display:flex;flex-direction:column;gap:18px}.card{padding:22px}.sectionTitle{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:18px}.sectionTitle h2{font-size:1.1rem}.verifiedBadge{color:#9bd4ff;background:#123458;border:1px solid #24558a;border-radius:999px;padding:7px 11px;font-size:.75rem}
.waitingProvider{display:flex;gap:15px;align-items:center;padding:16px;border:1px dashed #35506d;border-radius:14px;background:#0b1726}.waitingProvider p{color:var(--muted);margin-top:4px}.pulseAvatar,.providerPhotoWrap{width:82px;height:82px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:0 0 82px}.pulseAvatar{background:#123357;color:#7cc4ff;font-weight:900;font-size:1.3rem;animation:pulse 1.8s infinite}@keyframes pulse{50%{box-shadow:0 0 0 12px rgba(56,189,248,.05)}}.providerIdentity{display:grid;grid-template-columns:auto minmax(220px,1fr) minmax(200px,.7fr);gap:20px;align-items:center}.providerPhotoWrap{overflow:hidden;background:#14263b;border:2px solid #3988e8}.providerPhotoWrap img{width:100%;height:100%;object-fit:cover}#providerPhotoPlaceholder{font-weight:900;font-size:1.4rem}.providerNameBlock h3{font-size:1.3rem}.ratingLine{display:flex;gap:6px;align-items:center;margin:8px 0 14px;color:#d9e3ef}.providerButtons{display:flex;gap:10px;flex-wrap:wrap}.greenButton,.blueButton,.mainButton,.outlineButton,.helpButton,.cancelButton{border-radius:10px;padding:11px 15px;text-decoration:none;border:1px solid transparent;display:inline-flex;align-items:center;justify-content:center;font-weight:800}.greenButton{background:#14833f;color:#fff}.blueButton{background:#185db3;color:#fff}.mainButton{background:#1777dd;color:#fff;border:none}.outlineButton{background:#0c1827;color:#75baff;border-color:#2d6cae}.unitBox{border:1px solid var(--line);background:#0b1725;border-radius:13px;padding:15px}.unitBox p{color:var(--muted);margin-top:6px;font-size:.86rem}
.quickStats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:20px;border:1px solid var(--line);border-radius:14px;padding:15px}.quickStats>div{display:grid;grid-template-columns:auto 1fr;column-gap:9px;align-items:center}.quickStats>div>span{grid-row:1/3;font-size:1.65rem}.quickStats small{color:var(--muted);font-size:.66rem}.quickStats strong{font-size:1.25rem}.mapUpdate{color:var(--muted);font-size:.75rem}.mapWaiting{min-height:300px;border:1px dashed #36506d;border-radius:14px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);text-align:center;gap:8px}.mapWaiting span{font-size:2.6rem}.mapContainer{position:relative;min-height:390px;border-radius:14px;overflow:hidden;background:#0a1421}.mapContainer iframe{width:100%;height:390px;border:0;filter:saturate(.85) brightness(.85)}.mapFloating{position:absolute;left:18px;top:18px;background:rgba(255,255,255,.95);color:#132238;border-radius:10px;padding:10px 13px;box-shadow:0 8px 24px rgba(0,0,0,.25)}.mapFloating span{display:block;font-size:.75rem;margin-top:2px}.mapActions{display:flex;gap:10px;flex-wrap:wrap;margin-top:13px}.arrivalCard{display:flex;align-items:center;justify-content:space-between;gap:20px}.arrivalCard p,.ratingCard>p{color:var(--muted);margin-top:7px}.arrivalButtons{display:flex;gap:10px;flex-wrap:wrap}.buttonReset{border:none}
.summaryItem{display:grid;grid-template-columns:auto 1fr;gap:11px;margin:20px 0;align-items:flex-start}.summaryItem small{color:var(--muted);display:block;margin-bottom:5px}.dot{width:9px;height:9px;border-radius:50%;margin-top:5px}.blueDot{background:#3b82f6}.redDot{background:#ef4444}.grayDot{background:#64748b}.towDetails{border-top:1px solid var(--line);padding-top:10px}.towDetails p{display:flex;justify-content:space-between;gap:12px;padding:8px 0;color:var(--muted)}.towDetails b{color:var(--text);text-align:right}.actionCard{display:flex;flex-direction:column;gap:10px}.cancelButton{background:transparent;color:#fbbf24;border-color:#8d721c;width:100%}.helpButton{background:#3b155b;color:#e7b8ff;border-color:#67348d;width:100%}.wideButton{width:100%}.safetyCard{display:flex;gap:13px;background:linear-gradient(145deg,#0b2746,#0c1e34)}.safetyCard .shield{font-size:1.8rem}.safetyCard p{color:#c0d4e9;line-height:1.5;margin-top:5px;font-size:.88rem}
.stars{display:flex;gap:6px;margin:18px 0}.stars button{background:none;border:0;color:#536273;font-size:2.25rem;line-height:1;transition:.15s}.stars button.active{color:#fbbf24;transform:scale(1.08)}.ratingTags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}.ratingTags button{border:1px solid #34516e;border-radius:999px;padding:8px 11px;background:#0b1726;color:#c9d6e4}.ratingTags button.active{border-color:#4aa3ff;background:#12365c;color:#fff}.ratingCard textarea{width:100%;resize:vertical;min-height:100px;border:1px solid #31475f;border-radius:12px;background:#091522;color:#fff;padding:12px;outline:none;margin-bottom:12px}.inlineFeedback{margin-top:10px;color:#8de8b4}.whatsappPendingCard p{color:var(--muted);margin:8px 0 12px}
@media(max-width:980px){.serviceHeader{grid-template-columns:1fr auto}.headerCenter{display:none}.mainGrid{grid-template-columns:1fr}.heroTop{grid-template-columns:1fr 1fr}.statusBox{grid-column:1/-1;text-align:left}.providerIdentity{grid-template-columns:auto 1fr}.unitBox{grid-column:1/-1}}@media(max-width:650px){.serviceTrackingPage{padding:10px}.serviceHeader{display:flex;justify-content:space-between}.headerActions button{display:none}.headerActions a{padding:8px 11px}.heroCard,.card{padding:16px;border-radius:14px}.heroTop{grid-template-columns:1fr}.statusBox{grid-column:auto}.progressTrack{margin-top:22px}.progressStep{min-width:94px}.progressLine{min-width:30px}.providerIdentity{grid-template-columns:1fr;text-align:center}.providerPhotoWrap{margin:auto}.providerButtons{justify-content:center}.quickStats{grid-template-columns:1fr}.quickStats>div{padding:6px 0}.arrivalCard{flex-direction:column;align-items:flex-start}.mapContainer,.mapContainer iframe{min-height:300px;height:300px}}
